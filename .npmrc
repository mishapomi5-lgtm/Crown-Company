auto-install-peers=false
strict-peer-dependencies=false

# Lock optional dependencies for both the current platform (Linux x64) and
# Windows x64 so that `pnpm install` on a Windows machine resolves the correct
# native binaries (e.g. @tailwindcss/oxide-win32-x64-msvc) from the lockfile.
supported-architectures[os][]=current
supported-architectures[os][]=win32
supported-architectures[cpu][]=current
supported-architectures[cpu][]=x64
supported-architectures[libc][]=current
supported-architectures[libc][]=msvcrt
